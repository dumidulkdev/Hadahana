# Application Port
PORT=3000

# MongoDB Cloud Connection String (MongoDB Atlas)
MONGO_DATABASE_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hadahana?retryWrites=true&w=majority

# Redis Cloud Configuration
REDIS_HOST=redis-12345.c250.us-east-1-4.ec2.cloud.redislabs.com
REDIS_PORT=12345
REDIS_PASSWORD=your_redis_cloud_password_here

# Python Calculation Engine URLs
ENGINE_BASE_URL=http://localhost:8000
ENGINE_BASE_PATH=/api/analsye

# Required generation key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
